# development | test | production. "production" refuses to start with unsafe values (see app/config.py).
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars, not this placeholder) when ENVIRONMENT=production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=refmi-api
JWT_AUDIENCE=refmi-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
# How long the companion is out on its daily walk (minutes).
PET_WALK_MINUTES=480
# Seconds between background passes that grant rewards for walks that ended (0 = only when the app asks).
PET_REWARD_SWEEP_SECONDS=60
TASK_DAILY_EXP_CAP=60
STUDY_DAILY_EXP_CAP=48
# Study Together (docs/STUDY_TOGETHER.md). Group minutes use STUDY_DAILY_EXP_CAP; these cap the extras.
GROUP_DAILY_EXP_CAP=10
TEAM_QUEST_DAILY_EXP_CAP=30
# Background pass that advances group timers and presence (seconds; 0 = only when a room is read).
STUDY_ROOM_TICK_SECONDS=2
STUDY_ROOM_PRESENCE_SECONDS=70
# Focus credit continues this long after a member's last heartbeat (locked screen, short network loss).
STUDY_ROOM_AWAY_GRACE_SECONDS=600
STUDY_ROOM_IDLE_CLOSE_MINUTES=120
ROOM_INVITATION_HOURS=24
# Room chat messages are deleted this many days after they were sent.
STUDY_ROOM_MESSAGE_RETENTION_DAYS=30
FRIEND_REQUEST_COOLDOWN_HOURS=24
# Friend room visits: the same greeting/cheer/study invite to one friend once per cooldown, a daily cap per
# visitor, and how long unread greetings of one kind are merged into one notification. Visits never give EXP.
VISIT_INTERACTION_COOLDOWN_MINUTES=10
VISIT_INTERACTION_DAILY_LIMIT=40
VISIT_NOTIFICATION_GROUP_HOURS=12
# Calendar days for the login streak and its once-a-day popup follow this IANA timezone.
LOGIN_STREAK_TIMEZONE=Asia/Ho_Chi_Minh
# Learning games (docs/LEARNING_GAMES.md). Stage EXP shares TASK_DAILY_EXP_CAP with daily tasks.
LEARNING_STAGE_EXP=10
# Max play time counted between two requests; pause sessions left running; abandon forgotten ones; "Học thêm" limit.
LEARNING_IDLE_CAP_SECONDS=60
LEARNING_AUTO_PAUSE_SECONDS=90
LEARNING_EXPIRE_HOURS=24
LEARNING_MAX_DURATION_MINUTES=90

DATABASE_URL=sqlite:///./refmi.db

# Comma-separated admin account emails; grants the backend admin role at startup/login.
ADMIN_EMAILS=

# Only needed for the Expo web build; native apps don't use CORS. Never "*" in production.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006
# Redirect HTTP->HTTPS and send HSTS. Empty = on in production, off otherwise.
FORCE_HTTPS=

# Brute-force protection: "<requests>/<seconds>", tracked per process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_LOGIN_IP=50/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_PASSWORD_RESET=5/900
RATE_LIMIT_REFRESH=30/300
RATE_LIMIT_USER_SEARCH=30/60
RATE_LIMIT_FRIEND_REQUEST=20/3600
RATE_LIMIT_ROOM_CODE=10/300
RATE_LIMIT_ROOM_CODE_IP=60/300
RATE_LIMIT_ROOM_CREATE=10/3600
RATE_LIMIT_ROOM_INVITE=30/3600
RATE_LIMIT_REPORT=10/86400
RATE_LIMIT_REACTION=20/60
RATE_LIMIT_ROOM_MESSAGE=15/60
RATE_LIMIT_REALTIME_TICKET=30/60
RATE_LIMIT_VISIT_INTERACTION=20/600
RATE_LIMIT_FRIEND_LOOKUP=20/300

# Password reset email: disabled | console (dev only: prints the email to the server log) | smtp
EMAIL_BACKEND=disabled
EMAIL_FROM=Mirabi <no-reply@mirabi.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Optional web/deep link included in the email; the token is appended as ?token=...
PASSWORD_RESET_URL=
