# Must match BACKEND_AI_SERVICE_TOKEN configured in backend/.env
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Database is shared with the backend: AI tables are created by backend migrations.
DATABASE_URL=sqlite:///./backend/refmi.db
ENVIRONMENT=development
AI_SERVICE_ROLE=engine

# Model credentials stay in this service environment only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=500
