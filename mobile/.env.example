# Backend base URL. Everything in EXPO_PUBLIC_* is bundled into the app and is PUBLIC:
# never put secrets, database credentials, or AI keys here.
#
# Development: leave this unset. The app calls http://<computer running Metro>:8011, which works for
# Expo Go on a phone (same Wi-Fi), emulators and the web build. Set it only for a backend elsewhere,
# or when using `expo start --tunnel`.
# Release builds: required, and must be https://
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8011
