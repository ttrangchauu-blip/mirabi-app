{
  "expo": {
    "name": "Mirabi",
    "slug": "mirabi-app",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mirabi.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mirabi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF6FD"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "name": "Mirabi",
      "shortName": "Mirabi",
      "themeColor": "#1A7BBF",
      "backgroundColor": "#EAF7FD",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Mirabi cần quyền thư viện ảnh để lưu ảnh kỷ niệm.",
          "savePhotosPermission": "Mirabi lưu ảnh kỷ niệm vào thư viện ảnh của bạn.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mirabi dùng camera để quét mã QR kết bạn.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "391c9c8e-07e9-46db-9337-db936bc81df0"
      }
    },
    "owner": "mirabi-team"
  }
}
