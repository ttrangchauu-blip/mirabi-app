# Only the Dockerfile, backend/ and the app artwork the API reads are needed for the backend image.
# Never ship .env or databases.
.git/
.gitignore
.local-preview/
.pet-assets-backup-*/
.venv/
docs/
mobile/
!mobile/assets/room/room-art.json
!mobile/assets/pets/*/Lv*.png
README.md
package-lock.json
**/.env
**/*.db
**/*.log
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.pytest-*/
backend/tests/
backend/scripts/
